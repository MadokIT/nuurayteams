<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Nuurayteams — создавайте превью для ссылок, делайте скриншоты страниц и отправляйте их в WhatsApp."
    />
    <title>Nuurayteams</title>
    <style>
      :root {
        --bg-1: #09111f;
        --bg-2: #111827;
        --panel: rgba(17, 24, 39, 0.72);
        --panel-soft: rgba(255, 255, 255, 0.05);
        --border: rgba(148, 163, 184, 0.18);
        --text: #e5eefb;
        --muted: #a7b6d3;
        --green: #25d366;
        --green-dark: #1da851;
        --white: #ffffff;
        --shadow: 0 30px 60px rgba(0, 0, 0, 0.32);
      }

      * {
        box-sizing: border-box;
      }

      html, body {
        margin: 0;
        min-height: 100%;
        font-family: Arial, Helvetica, sans-serif;
        background: linear-gradient(135deg, var(--bg-1), var(--bg-2));
        color: var(--text);
      }

      body {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px 18px;
      }

      .app {
        width: min(1080px, 100%);
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 28px;
        backdrop-filter: blur(18px);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .header {
        padding: 34px 28px 18px;
      }

      .brand {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
      }

      .brand-title {
        margin: 0;
        font-size: clamp(2rem, 3vw, 3rem);
        letter-spacing: 0.04em;
      }

      .brand-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(37, 211, 102, 0.12);
        border: 1px solid rgba(37, 211, 102, 0.22);
        color: #b9f7cc;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
      }

      .brand-badge::before {
        content: "";
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--green);
        display: inline-block;
      }

      .subtitle {
        margin-top: 10px;
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.6;
      }

      .panel {
        padding: 0 28px 28px;
      }

      .input-wrap {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 20px;
      }

      .input {
        flex: 1 1 560px;
        min-width: 200px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.03);
        padding: 18px 18px;
        font-size: 1rem;
        color: var(--text);
        outline: none;
      }

      .input::placeholder {
        color: #90a2c0;
      }

      .actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 22px;
      }

      button {
        border: none;
        border-radius: 14px;
        padding: 14px 22px;
        font-size: 0.98rem;
        font-weight: 700;
        cursor: pointer;
        transition: transform 0.15s ease, opacity 0.15s ease;
      }

      button:hover {
        transform: translateY(-1px);
      }

      button:active {
        transform: translateY(0);
      }

      .primary {
        background: var(--green);
        color: #062914;
      }

      .secondary {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--border);
        color: var(--text);
      }

      .card {
        display: none;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border);
        border-radius: 22px;
        overflow: hidden;
      }

      .card.visible {
        display: block;
      }

      .card-image {
        width: 100%;
        display: block;
        background: #dfe6f4;
        max-height: 520px;
        object-fit: cover;
      }

      .card-body {
        padding: 20px 22px 24px;
      }

      .card-title {
        margin: 0 0 12px;
        font-size: clamp(1.35rem, 2vw, 2rem);
      }

      .card-link {
        color: #8be7b1;
        text-decoration: none;
        word-break: break-all;
        font-weight: 700;
      }

      .history {
        margin-top: 26px;
        padding-top: 16px;
        border-top: 1px solid var(--border);
      }

      .history h3 {
        margin: 0 0 12px;
        color: var(--muted);
        font-size: 0.95rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .history-list {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .history-item {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 10px 14px;
        color: var(--text);
        cursor: pointer;
        font-size: 0.9rem;
      }

      @media (max-width: 640px) {
        .header, .panel {
          padding-left: 18px;
          padding-right: 18px;
        }

        .brand {
          align-items: flex-start;
        }

        .actions {
          flex-direction: column;
        }

        .actions button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div class="app">
      <header class="header">
        <div class="brand">
          <h1 class="brand-title">Nuurayteams</h1>
          <span class="brand-badge">Live Preview</span>
        </div>
        <p class="subtitle">
          Подготовьте ссылку, сделайте скриншот страницы и быстро отправьте её в WhatsApp.
        </p>
      </header>

      <main class="panel">
        <div class="input-wrap">
          <input
            id="urlInput"
            class="input"
            type="text"
            value="https://example.com"
            placeholder="Вставьте ссылку..."
            aria-label="Ссылка"
          />
        </div>

        <div class="actions">
          <button id="previewBtn" class="primary" type="button">Сделать скриншот</button>
          <button id="copyBtn" class="secondary" type="button">Копировать ссылку</button>
          <button id="whatsappBtn" class="secondary" type="button">Отправить в WhatsApp</button>
        </div>

        <section id="previewCard" class="card" aria-live="polite">
          <img id="previewImage" class="card-image" alt="Скриншот страницы" />
          <div class="card-body">
            <h2 id="previewTitle" class="card-title">Название страницы</h2>
            <a id="previewLink" class="card-link" href="#" target="_blank" rel="noreferrer">Ссылка</a>
          </div>
        </section>

        <section class="history">
          <h3>Последние ссылки</h3>
          <div id="historyList" class="history-list"></div>
        </section>
      </main>
    </div>

    <script>
      const urlInput = document.getElementById('urlInput');
      const previewCard = document.getElementById('previewCard');
      const previewImage = document.getElementById('previewImage');
      const previewTitle = document.getElementById('previewTitle');
      const previewLink = document.getElementById('previewLink');
      const historyList = document.getElementById('historyList');

      const STORAGE_KEY = 'nuurayteams_history';

      function normalizeUrl(value) {
        const trimmed = String(value || '').trim();
        if (!trimmed) return '';
        if (/^https?:\/\//i.test(trimmed)) return trimmed;
        return `https://${trimmed}`;
      }

      function saveHistory(url) {
        let history = [];

        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved) history = JSON.parse(saved);
        } catch (err) {
          history = [];
        }

        history = [url, ...history.filter(item => item !== url)].slice(0, 5);
        localStorage.setItem(STORAGE_KEY, JSON.stringify(history));
        renderHistory();
      }

      function renderHistory() {
        let history = [];

        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved) history = JSON.parse(saved);
        } catch (err) {
          history = [];
        }

        if (!history.length) {
          historyList.innerHTML = '<span style="color: var(--muted); opacity: 0.8;">Пока нет ссылок</span>';
          return;
        }

        historyList.innerHTML = history
          .map(
            (item) =>
              `<button class="history-item" type="button" data-url="${item}">${item}</button>`
          )
          .join('');

        historyList.querySelectorAll('.history-item').forEach((item) => {
          item.addEventListener('click', () => {
            const value = item.getAttribute('data-url');
            urlInput.value = value;
            makePreview();
          });
        });
      }

      async function makePreview() {
        const url = normalizeUrl(urlInput.value);
        if (!url) {
          alert('Введите ссылку');
          return;
        }

        try {
          const response = await fetch('/api/preview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url }),
          });

          const data = await response.json();

          if (!response.ok) {
            alert(data.error || 'Ошибка загрузки');
            return;
          }

          previewImage.src = data.image;
          previewTitle.textContent = data.title || 'Без названия';
          previewLink.href = data.url;
          previewLink.textContent = data.url;
          previewCard.classList.add('visible');

          saveHistory(data.url);
        } catch (error) {
          alert('Ошибка соединения с сервером');
        }
      }

      document.getElementById('previewBtn').addEventListener('click', makePreview);

      document.getElementById('copyBtn').addEventListener('click', async () => {
        const url = normalizeUrl(urlInput.value);
        if (!url) {
          alert('Введите ссылку');
          return;
        }

        try {
          await navigator.clipboard.writeText(url);
          alert('Ссылка скопирована');
        } catch (error) {
          console.error(error);
          alert('Не удалось скопировать ссылку');
        }
      });

      document.getElementById('whatsappBtn').addEventListener('click', () => {
        const url = normalizeUrl(urlInput.value);
        if (!url) {
          alert('Введите ссылку');
          return;
        }

        const text = encodeURIComponent(url);
        window.open(`https://wa.me/?text=${text}`, '_blank');
      });

      renderHistory();
    </script>
  </body>
</html>
